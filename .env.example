# Path of the serial device inside the container (see devices: in docker-compose.yml)
SERIAL_PORT=/dev/ttyUSB0

MQTT_BROKER=192.168.1.10
MQTT_PORT=1883
MQTT_TOPIC_PREFIX=GHP
# Leave empty for a broker without authentication
MQTT_USERNAME=ghp
MQTT_PASSWORD=changeme

# DEBUG, INFO, WARNING or ERROR
LOG_LEVEL=ERROR
